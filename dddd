local function getBuildRemote()
    local char = LP.Character
    local bp = LP:FindFirstChildOfClass("Backpack")
    local tool = (char and char:FindFirstChild("Build")) or (bp and bp:FindFirstChild("Build"))
    if not tool then return nil, nil end
    local s = tool:FindFirstChild("Script")
    local r = s and s:FindFirstChild("Event")
    if r and r:IsA("RemoteEvent") then return r, tool end
    return nil, nil
end

local function snapAxis(v) return math.round((v - 2) / 4) * 4 + 2 end
local function snapVec(p) return Vector3.new(snapAxis(p.X), snapAxis(p.Y), snapAxis(p.Z)) end

local function textPoints(text, spacing)
    local pts = {}
    local x = 0
    for i = 1, #text do
        local c = text:sub(i,i):upper()
        local glyph = FONT[c]
        if glyph then
            for row = 1, 5 do
                for col = 1, #glyph[row] do
                    if glyph[row]:sub(col,col) == "#" then
                        table.insert(pts, Vector3.new((x+col-1)*spacing, (5-row)*spacing, 0))
                    end
                end
            end
            x = x + #glyph[1] + 1
        end
    end
    return pts
end

