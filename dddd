-- ===== BUILD =====
local function buildText(text)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then Status.Text = "No character" return end

    local remote, tool = getBuildRemote()
    if not remote then Status.Text = "No Build tool found" return end

    if tool.Parent ~= char then
        tool.Parent = char
        task.wait(0.1)
    end

    local origin = root.CFrame
    local _, yaw = root.CFrame:ToOrientation()
    local snapped = math.round(yaw / (math.pi/2)) * (math.pi/2)
    local frame = CFrame.new(root.Position) * CFrame.Angles(0, snapped, 0) * CFrame.new(0, 0, -8)

    local spacing = buildMode == "normal" and 4 or 1
    local pts = textPoints(text, spacing)
    local total = #pts
    if total == 0 then Status.Text = "No valid characters" return end

    Status.Text = "Building 0/" .. total .. " (" .. buildMode .. ")"

    for i, off in ipairs(pts) do
        if stopRequested then break end
        if not root.Parent then break end

        local pos = (frame * CFrame.new(off)).Position
        if buildMode == "normal" then
            pos = snapVec(pos)
        end
        root.CFrame = CFrame.new(pos + Vector3.new(0, 6, 0))
        remote:FireServer(workspace.Terrain, Enum.NormalId.Top, pos, buildMode)

        task.wait(buildDelay)

        if i % 3 == 0 or i == total then
            Status.Text = "Building " .. i .. "/" .. total
        end
    end

    if root.Parent then root.CFrame = origin end
    Status.Text = stopRequested and ("Stopped at " .. total .. " blocks") or ("Done! " .. total .. " blocks")
end

